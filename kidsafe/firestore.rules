rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Short-lived pairing codes. Parent creates; child redeems once.
    match /pairings/{code} {
      allow get: if signedIn();          // child looks up a code it was given
      allow list: if false;              // nobody can list/guess codes in bulk

      allow create: if signedIn()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm');

      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;

      allow delete: if signedIn() && resource.data.parentUid == request.auth.uid;
    }

    match /children/{childId} {

      function pairingOf(code) {
        return get(/databases/$(database)/documents/pairings/$(code)).data;
      }

      // Child creates its own record, only with a valid unused, unexpired code.
      allow create: if signedIn()
        && request.auth.uid == childId
        && exists(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode))
        && pairingOf(request.resource.data.pairingCode).parentUid == request.resource.data.parentUid
        && pairingOf(request.resource.data.pairingCode).used == false
        && pairingOf(request.resource.data.pairingCode).expiresAt > request.time;

      // Child can read its own record; the linked parent can read/list theirs.
      allow read: if signedIn()
        && (request.auth.uid == childId || request.auth.uid == resource.data.parentUid);

      // Child updates its own status (lastLocation, lastEvent, consent) but can't re-assign the parent.
      allow update: if signedIn()
        && request.auth.uid == childId
        && request.resource.data.parentUid == resource.data.parentUid;

      // Parent can unlink.
      allow delete: if signedIn() && request.auth.uid == resource.data.parentUid;

      match /locations/{docId} {
        allow create: if signedIn() && request.auth.uid == childId;
        allow read: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid;
      }

      match /events/{docId} {
        allow create: if signedIn() && request.auth.uid == childId;
        allow read: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid;
      }

      // Safe places: the linked parent manages them, the child reads them (to set up geofences).
      match /places/{placeId} {
        allow read: if signedIn()
          && (request.auth.uid == childId
              || request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid);
        allow create, update, delete: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid;
      }

      // Web filter: the parent changes the settings, the child reads them.
      match /settings/{docId} {
        allow read: if signedIn()
          && (request.auth.uid == childId
              || request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid);
        allow create, update, delete: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid;
      }

      // Blocked-site attempts: the child writes, the linked parent reads.
      match /blocked/{docId} {
        allow create: if signedIn() && request.auth.uid == childId;
        allow read: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid;
      }

      // Live screen-share frame: only the child can write it (only the child can start/stop
      // sharing); the linked parent reads it.
      match /screenshare/{docId} {
        allow read: if signedIn()
          && (request.auth.uid == childId
              || request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid);
        allow create, update, delete: if signedIn() && request.auth.uid == childId;
      }

      // Daily app-usage summary: child writes, linked parent reads.
      match /usage/{day} {
        allow create, update: if signedIn() && request.auth.uid == childId;
        allow read: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid;
      }

      // Parent <-> child chat. Either side can write, but only as themselves; messages are
      // never edited or deleted, and only the two linked people can ever read them.
      match /messages/{docId} {
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && (request.auth.uid == childId
              || request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid);
        allow read: if signedIn()
          && (request.auth.uid == childId
              || request.auth.uid == get(/databases/$(database)/documents/children/$(childId)).data.parentUid);
      }
    }
  }
}
